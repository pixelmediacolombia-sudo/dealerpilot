{
  "manifest_version": 3,
  "name": "DealerPilot AI (Spike)",
  "version": "0.1.0",
  "description": "Sprint 0 proof of concept: connects a Replit web app to Facebook Marketplace and Messenger for assisted listing and replies.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.replit.dev/*",
    "https://*.replit.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://facebook.com/*",
        "https://www.messenger.com/*",
        "https://messenger.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DealerPilot AI"
  }
}
