{
  "manifest_version": 3,
  "name": "DealerPilot AI Publisher",
  "version": "1.4.1",
  "description": "Connects DealerPilot AI to Facebook Marketplace, fills listings, publishes controlled jobs, and handles authorized Marketplace promotions.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://*.replit.dev/*",
    "https://*.replit.app/*",
    "https://*.onrender.com/*",
    "https://app.1987dealerpilot.com/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.replit.app/*",
      "https://*.replit.dev/*",
      "https://*.onrender.com/*",
      "https://app.1987dealerpilot.com/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "src/shared/theme.js",
        "src/content/facebook/selectors.js",
        "src/content/facebook/formFiller.js",
        "src/content/facebook/photoUploader.js",
        "src/content/facebook/validation.js",
        "src/content/facebook/publisherFlow.js",
        "content/content.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DealerPilot AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
