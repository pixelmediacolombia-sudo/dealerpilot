{
  "manifest_version": 3,
  "name": "DealerPilot AI Publisher",
  "version": "1.2.4",
  "description": "Connects the DealerPilot AI dashboard to Facebook Marketplace: claims publishing jobs from the queue and fills listing forms for operator review. Never auto-clicks Publish.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://*.replit.dev/*",
    "https://*.replit.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://facebook.com/*",
        "https://www.messenger.com/*",
        "https://messenger.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DealerPilot AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
