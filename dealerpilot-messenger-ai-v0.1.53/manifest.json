{
  "manifest_version": 3,
  "name": "DealerPilot Messenger AI",
  "version": "0.1.53",
  "description": "Detects Facebook Marketplace buyer conversations, requests DealerPilot AI suggestions, and replies only when explicitly enabled.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://*.replit.dev/*",
    "https://*.replit.app/*",
    "https://*.onrender.com/*",
    "https://1987dealerpilot.com/*",
    "https://www.1987dealerpilot.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/messages/t/*",
        "https://web.facebook.com/messages/t/*",
        "https://facebook.com/messages/t/*",
        "https://www.facebook.com/marketplace/inbox*",
        "https://web.facebook.com/marketplace/inbox*",
        "https://facebook.com/marketplace/inbox*"
      ],
      "js": [
        "src/content/facebook/messengerCapture.js",
        "src/content/facebook/messengerAutonomy.js",
        "src/content/facebook/messengerAi.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DealerPilot Messenger AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
